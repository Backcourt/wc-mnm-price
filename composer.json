{
  "name": "kathyisawesome/wc-mnm-price",
  "description": "Validate mix and match products by price.",
  "homepage": "https://github.com/kathyisawesome/wc-mnm-price",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "helgatheviking",
      "email": "507025+helgatheviking@users.noreply.github.com"
    }
  ],
  "support": {
    "source": "https://github.com/kathyisawesome/wc-mnm-price",
    "issues": "https://github.com/kathyisawesome/wc-mnm-price/issues"
  },
  "require-dev": {
    "woocommerce/woocommerce-sniffs": "^1.0",
    "wp-cli/i18n-command": "^2.6"
  },
  "scripts": {
    "makepot-audit": [
      "wp --allow-root i18n make-pot . languages/wc-mnm-price.pot --slug=wc-mnm-price --exclude=\".github,.wordpress-org,build,deploy,node_modules,packages,vendor\" --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/kathyisawesome/wc-mnm-price/issues/new\"}'"
    ],
    "makepot": [
      "@makepot-audit --skip-audit"
    ],
    "phpcs": [
      "phpcs . -s -p -n"
    ],
    "phpcs-pre-commit": [
      "phpcs . -s -p -n"
    ],
    "phpcb": [
      "phpcbf . "
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "scripts-description": {
      "makepot": "Generate a .pot file for translation",
      "makepot-audit": "Generate a .pot file for translation. Dry run.",
      "phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
      "phpcb": "Fix coding standards warnings/errors automatically with PHP Code Beautifier"
    }
  }
}
